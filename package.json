{
	"name": "@directus/n8n-nodes-directus",
	"version": "1.0.3",
	"description": "n8n community node package for Directus CMS integration",
	"keywords": [
		"n8n-community-node-package",
		"directus",
		"cms"
	],
	"license": "MIT",
	"homepage": "https://github.com/directus/n8n-nodes-directus",
	"author": {
		"name": "Directus Labs",
		"email": "hello@directus.io"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/directus/n8n-nodes-directus.git"
	},
	"engines": {
		"node": ">=22.16.0"
	},
	"packageManager": "npm@10.9.0",
	"main": "index.js",
	"scripts": {
		"build": "npx rimraf dist && tsc && gulp build:icons",
		"build:n8n": "n8n-node build",
		"dev": "tsc --watch",
		"dev:n8n": "n8n-node dev",
		"format": "prettier 'nodes/**/*ts' 'credentials/**/*.ts' --write",
		"lint": "eslint .",
		"lintfix": "eslint . --fix",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"release": "n8n-node release",
		"prepublishOnly": "npm run build && eslint -c eslint.config.prepublish.mjs ."
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"credentials": [
			"dist/credentials/DirectusApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Directus/Directus.node.js",
			"dist/nodes/DirectusTrigger/DirectusTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"@typescript-eslint/eslint-plugin": "~8.32.0",
		"@typescript-eslint/parser": "~8.32.0",
		"eslint": "^9.32.0",
		"eslint-plugin-n8n-nodes-base": "^1.16.3",
		"gulp": "^5.0.0",
		"prettier": "^3.5.3",
		"typescript": "^5.8.2",
		"vitest": "^4.1.5"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"overrides": {
		"@humanfs/node": "^0.16.8",
		"axios": "^1.20.0",
		"brace-expansion": "^2.1.4",
		"form-data": "^4.0.6",
		"js-yaml": "^4.3.2",
		"minimatch": "^9.0.7",
		"tmp": "^0.2.7",
		"undici": "^6.28.1",
		"uuid": "^11.1.1",
		"vite": "^8.3.0",
		"ws": "^8.21.3"
	}
}
